{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "timeout": 120, "statusMessage": "depgraph: loading findings", "command": "sh \"${PLUGIN_ROOT}/scripts/hook.sh\" session-start codex" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "timeout": 10, "command": "sh \"${PLUGIN_ROOT}/scripts/hook.sh\" prompt codex" }
        ]
      }
    ]
  }
}
