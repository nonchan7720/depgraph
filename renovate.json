{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinAllExceptPeerDependencies",
    "helpers:pinGitHubActionDigestsToSemver",
    "docker:pinDigests"
  ],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 9am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Go modules: one PR per week for non-major updates",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "go modules (non-major)",
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "description": "web/ npm dependencies: one PR per week for non-major updates",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "web dependencies (non-major)",
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "description": "Toolchain pinned in mise.toml",
      "matchManagers": [
        "mise"
      ],
      "groupName": "mise tools",
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "description": "goreleaser (mise.toml aqua:goreleaser/goreleaser, read from git tags): stable releases only, never the *-nightly tags",
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "goreleaser/goreleaser"
      ],
      "allowedVersions": "!/nightly/"
    },
    {
      "description": "GitHub Actions (SHA pinned with a full semver comment)",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "description": "Neo4j stays on the 5.x line (docker-compose and the CI service container)",
      "matchPackageNames": [
        "neo4j"
      ],
      "allowedVersions": "<6"
    }
  ],
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ]
}
