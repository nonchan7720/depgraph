{
  "name": "depgraph-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --mode mcp-app",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:no-cdn": "node scripts/check-no-cdn.ts ../pkg/interfaces/handler/ui/dist ../pkg/interfaces/handler/mcpapp/dist"
  },
  "dependencies": {
    "cytoscape": "3.34.4",
    "elkjs": "0.12.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
